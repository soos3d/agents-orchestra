# Copy to .env and fill in.

# Anthropic auth for the orchestrator (Fable) and Claude Code workers.
# Either an API key, or leave blank if the Claude Code CLI is already logged in
# with your subscription (the SDK reuses that session).
ANTHROPIC_API_KEY=

# The git repository the agents will work in. Absolute path.
TARGET_REPO=/Users/david/code/your-project

# Where per-task git worktrees are created (defaults to <TARGET_REPO>/../.orchestra-worktrees)
WORKTREE_ROOT=

# Orchestrator model. 'fable' if your SDK build accepts the alias; otherwise a full model id.
ORCHESTRATOR_MODEL=fable

# Default model for Claude Code workers (headless `claude -p`).
CLAUDE_WORKER_MODEL=sonnet

# Codex model used by `codex exec`.
CODEX_WORKER_MODEL=gpt-5-codex

# Max concurrent workers the orchestrator should run.
MAX_CONCURRENCY=3
