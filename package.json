{
  "name": "fable-orchestra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Fable-brained orchestrator that dispatches coding tasks to Claude Code and Codex workers in isolated git worktrees.",
  "bin": {
    "orchestra": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --import tsx --no-warnings src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --no-warnings --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "picomatch": "^4.0.5",
    "ws": "^8.21.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
