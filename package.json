{
  "name": "fable-orchestra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Fable-brained orchestrator that dispatches coding tasks to Claude Code and Codex workers in isolated git worktrees.",
  "bin": {
    "orchestra": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --loader tsx --no-warnings src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
