# Nothing here is required.
#
# Config is discovered, not declared (§2a): the repo comes from `cwd`, the
# verification command from your package.json / Makefile / pyproject.toml, and the
# available workers from PATH. `orchestra doctor` reports what it found and what is
# missing. These variables only ever override that.

# Anthropic auth for the orchestrator. Leave blank if the Claude Code CLI is already
# logged in with your subscription — the SDK reuses that session.
ANTHROPIC_API_KEY=

# Work in a repo other than the one you are standing in. Absolute path.
TARGET_REPO=

# Where mission state, event logs, and artifacts live.
# Defaults to <repo>/.orchestra — gitignored automatically, on every run (§17).
ORCHESTRA_STATE_DIR=

# Where per-task git worktrees are created.
# Defaults to <repo>/../.orchestra-worktrees
WORKTREE_ROOT=

# Orchestrator model for `plan`, `research`, `synthesize`, and `judge`. An alias or a
# full model id. `progress` runs on a cheaper model regardless (§3) — it is a small
# judgment called every round.
#
# This is the default a mission inherits, not the last word: a mission can choose its
# own on the compose card or with `run --orchestrator-model`, and what it chose is
# recorded in its log so a resume runs on the same one.
ORCHESTRATOR_MODEL=opus

# Ceiling on concurrent workers. Per-kind limits still apply — `computer` tasks never
# run more than one at a time, whatever this says (§3).
MAX_CONCURRENCY=4

# An OpenClaw Gateway to mirror the inbox to (§2). Loopback only — doctor refuses
# anything else (§17). Leave blank for no mirror, which is the default.
ORCHESTRA_GATEWAY_URL=

# Print stack traces instead of just the actionable message.
ORCHESTRA_DEBUG=

# API keys for the model providers a card can name (`providers/README.md`). Both
# optional and both blank by default: with no key set, nothing about a mission changes —
# `orchestra doctor` reports "none configured" and no card is ever offered. Setting one
# is what lets `doctor` probe that provider's cards and write the transcript each card's
# `verifiedBy` names, which is the only thing that puts a model on a menu.
NEBIUS_API_KEY=
OLLAMA_API_KEY=

# The image a contained worker runs in (PLAN-NEXT 3.2). There is no default and there
# must not be one: the image has to hold your agent CLI, already logged in, and no such
# image has been verified for this project. Blank means containment is unavailable —
# `orchestra doctor` says so, and a mission composed with containment is refused at
# validation rather than at dispatch. The backend itself (Docker or Podman) is probed.
ORCHESTRA_CONTAINER_IMAGE=
